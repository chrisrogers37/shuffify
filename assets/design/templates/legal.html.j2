{%- from 'macros/design.html' import skip_link, public_header, public_footer -%}
<!DOCTYPE html>
<html lang="en" class="sh-document">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - Shuffify</title>
    <link rel="icon" type="image/svg+xml" href="/static/images/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/static/images/favicon.ico">
    <link rel="stylesheet" href="/static/css/tailwind.css">
</head>
<body class="sh-shell sh-public-shell">
{{ skip_link() | indent(4, first=true) }}
{{ public_header(home_url, terms_url, privacy_url, current_page) | indent(4, first=true) }}
    <main id="main-content" class="sh-container legal-page" tabindex="-1">
        <article class="legal-document" aria-labelledby="legal-title">
            <header class="legal-heading">
                <h1 id="legal-title">{{ title }}</h1>
            </header>
{{ legal_copy }}            <div class="legal-back">
                <a href="{{ home_url }}" class="sh-button-secondary">← Back to Shuffify</a>
            </div>
        </article>
    </main>
{{ public_footer(year, terms_url, privacy_url, current_page) | indent(4, first=true) }}
</body>
</html>
