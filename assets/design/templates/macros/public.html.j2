{# Shared shell markup. All inputs are explicit so static builds need no Flask context. #}
{% macro brand(home_url) -%}
<a class="sh-brand" href="{{ home_url }}" aria-label="Shuffify home">
    <span class="sh-brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="m16 3 4 4-4 4M4 17h3c4 0 6-10 10-10h3M16 13l4 4-4 4M4 7h3c1.4 0 2.6 1.3 3.7 3M13 14c1.3 1.8 2.5 3 4 3h3"/>
    </svg></span>
    shuffify
</a>
{%- endmacro %}

{% macro skip_link(target_id='main-content') -%}
<a href="#{{ target_id }}" class="sh-skip-link">Skip to main content</a>
{%- endmacro %}

{% macro public_header(home_url, terms_url, privacy_url, current_page='') -%}
<header class="sh-public-nav">
    <div class="sh-container sh-nav-inner">
{{ brand(home_url) | indent(8, first=true) }}
        <nav class="sh-nav-links" aria-label="Public navigation">
            <a href="{{ terms_url }}"{% if current_page == 'terms' %} aria-current="page"{% endif %}>Terms</a>
            <a href="{{ privacy_url }}"{% if current_page == 'privacy' %} aria-current="page"{% endif %}>Privacy</a>
        </nav>
    </div>
</header>
{%- endmacro %}

{% macro public_footer(year, terms_url, privacy_url, current_page='') -%}
<footer class="sh-footer">
    <div class="sh-container sh-footer-inner">
        <div>
            <p>Shuffify is an independent app, unaffiliated with Spotify.</p>
            <p>© {{ year }} Shuffify. All rights reserved.</p>
        </div>
        <nav class="sh-nav-links" aria-label="Legal navigation">
            <a href="{{ terms_url }}"{% if current_page == 'terms' %} aria-current="page"{% endif %}>Terms of Service</a>
            <a href="{{ privacy_url }}"{% if current_page == 'privacy' %} aria-current="page"{% endif %}>Privacy Policy</a>
        </nav>
    </div>
</footer>
{%- endmacro %}
