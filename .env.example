# Shuffify Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Spotify API (REQUIRED) ───────────────────────────────────
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# 127.0.0.1, not localhost: Spotify refuses localhost redirect URIs. Open the
# app on the same host and port as this URI, so the login cookie set there
# comes back at the callback (with the web dev server: http://127.0.0.1:5173).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# ─── App Configuration ───────────────────────────────────────
# development or production (selects config class in config.py)
APP_CONFIG=development
# Required on the production API in the split Vercel -> Railway deployment.
# PUBLIC_ORIGIN=https://shuffify.app
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Fernet key that encrypts stored Spotify refresh tokens. Required for the
# production API and worker; development generates a temporary one when unset,
# so stored tokens last only as long as the process.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# ─── Redis (recommended) ──────────────────────────────────────
# Used for session storage and Spotify API response caching.
# If not set, falls back to filesystem sessions (no caching).
# Format: redis://[[username]:[password]@]host[:port][/database]
REDIS_URL=redis://localhost:6379/0

# ─── Database ─────────────────────────────────────────────────
# SQLite is used by default for local development. The Railway API and worker
# require an owner-set direct, unpooled Neon URL; it is also used by the API's
# pre-deploy migration. Production uses the `production` branch of the Neon
# project `shuffify-db`. A nonproduction environment needs its own branch; a
# backup branch is not staging, and staging must never point at production.
# Verify the project and branch before setting the URL.
#
# Railway placeholder (replace only in Railway; do not commit the real URL):
# DATABASE_URL=<owner-supplied-direct-unpooled-Neon-URL>
#
# Local PostgreSQL:
# DATABASE_URL=postgresql://localhost:5432/shuffify_dev
#
# Note: Both postgres:// and postgresql:// prefixes are accepted locally.
# The app selects the installed psycopg2 driver for either prefix.
# DATABASE_URL=

# ─── Server ───────────────────────────────────────────────────
PORT=8000

# Only the operation worker runs scheduled jobs; API processes never start APScheduler.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
# Use one worker replica initially. Configure the same private token on API and worker.
# Leave URL/token empty to disable private control; PostgreSQL notifications still wake the worker.
WORKER_CONTROL_URL=
WORKER_CONTROL_TOKEN=
WORKER_CONTROL_HOST=127.0.0.1
WORKER_CONTROL_PORT=5001
WORKER_CONTROL_TIMEOUT=0.5
